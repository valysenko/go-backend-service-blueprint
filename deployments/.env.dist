APP_ENV=loc
NAMESPACE=blueprint
POD_NAME=blueprint-pod

# http app
SERVER_PORT=8096
READ_TIMEOUT=60
WRITE_TIMEOUT=120
REQUEST_TIMEOUT=10
BODY_LIMIT_BYTES=5242880
USER_CREATE_RATE_LIMIT_PER_MINUTE=60

# postgres
DB_HOST=blueprint-postgres
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=blueprint_db
DB_SSL_MODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5
DB_MIGRATIONS_DIR=./internal/infrastructure/postgres/migrations
POSTGRES_HOST_AUTH_METHOD=trust

# redis
REDIS_URL=blueprint-redis:6379
REDIS_PASSWORD=
REDIS_DB=0
