{
    "swagger": "2.0",
    "info": {
        "description": "Reference HTTP API of the service blueprint.",
        "title": "Go Backend Service Blueprint API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthcheck/": {
            "get": {
                "description": "Reports the liveness of the app and its backing services.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "healthcheck"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/healthcheck.HealthcheckResult"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/healthcheck.HealthcheckResult"
                        }
                    }
                }
            }
        },
        "/hello": {
            "get": {
                "description": "Minimal endpoint demonstrating the presentation layer.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "hello"
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/hello.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "healthcheck.HealthcheckResult": {
            "type": "object",
            "properties": {
                "healthcheck_results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/healthcheck.ServiceResult"
                    }
                }
            }
        },
        "healthcheck.ServiceResult": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "hello.Response": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        }
    }
}